# Copy this file to `.env` in the same directory (backend/.env) and fill
# in real values. Never commit the real .env file.

# --- Django -----------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=replace-this-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL + PostGIS) -----------------------------------
DB_NAME=campusgig
DB_USER=campusgig_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- CampusGig domain settings ------------------------------------------
DEFAULT_DISCOVERY_RADIUS_KM=20
TIME_ZONE=Asia/Kolkata

# --- Authentication (Phase 3) --------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Rate limit applied to register/login/refresh/logout, e.g. "10/min".
AUTH_THROTTLE_RATE=10/min

# --- GDAL/GEOS overrides (usually leave blank) --------------------------
# Only needed if GeoDjango cannot auto-detect these on your OS (mainly
# some Windows/macOS installs). Leave blank on Linux and inside Docker.
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=
