# CampusGig — root environment for the full docker compose stack (Phase 13).
# Copy to `.env` at the repository root and fill in real values before
# `docker compose up --build`. The api/worker/beat services read these.

# --- Django (required; compose refuses to start without SECRET_KEY) --------
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=replace-with-a-long-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,api
API_PORT=8000
FRONTEND_PORT=80

# Initial Django admin (entrypoint creates it once, idempotently).
DJANGO_SUPERUSER_EMAIL=admin@campusgig.local
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-password

# --- Database (must match the db service) ------------------------------------
DB_NAME=campusgig
DB_USER=campusgig_user
DB_PASSWORD=change-me

# --- Serving mode ------------------------------------------------------------
# asgi (daphne, default — preserves Channels WebSockets) or wsgi (gunicorn,
# HTTP-only replicas). The chat WebSocket stack works out of the box in asgi.
SERVER_KIND=asgi
GUNICORN_WORKERS=3

# Normally empty in production: the nginx frontend proxies /api on one origin.
# Only set when exposing the API on its own domain.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# --- Email (notifications) -----------------------------------------------------
# Console backend prints emails to the api container log; switch to SMTP and
# set PHASE7_EMAIL_NOTIFICATIONS=True for real delivery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
PHASE7_EMAIL_NOTIFICATIONS=False
DEFAULT_FROM_EMAIL=notifications@campusgig.local
